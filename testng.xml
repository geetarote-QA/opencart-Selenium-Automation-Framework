<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart Regression Suite">

    <test name="All OpenCart Tests">

        <classes>

            <!-- Runs login functionality tests -->
            <class name="com.geeta.automation.opencart.tests.LoginTest"/>

            <!-- Runs registration functionality tests -->
            <class name="com.geeta.automation.opencart.tests.RegisterTest"/>

            <!-- Runs product search functionality tests -->
            <class name="com.geeta.automation.opencart.tests.SearchTest"/>
            
            <!-- Runs shopping cart functionality tests -->
            <class name="com.geeta.automation.opencart.tests.CartTest"/>
            
            <!-- Runs guests checkout and billing functionality tests-->
			<class name="com.geeta.automation.opencart.tests.CheckoutTest"/>

        </classes>

    </test>

</suite>